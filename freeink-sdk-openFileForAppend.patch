+bool SDCardManager::openFileForAppend(const char* moduleName, const char* path, FsFile& file) {
+  file = vol().open(path, O_WRONLY | O_CREAT | O_APPEND);
+  if (!file) {
+    if (Serial) Serial.printf("[%lu] [%s] Failed to open file for appending: %s\n", millis(), moduleName, path);
+    return false;
+  }
+  return true;
+}
+
+bool SDCardManager::openFileForAppend(const char* moduleName, const std::string& path, FsFile& file) {
+  return openFileForAppend(moduleName, path.c_str(), file);
+}
